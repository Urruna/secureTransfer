# ============================================================================
#  SecureTransfer 密钥与身份配置模板（带外预配置）
#
#  用法：
#      cp configs/keys.conf.example configs/keys.conf
#      chmod 600 configs/keys.conf
#  程序读取的是 configs/keys.conf（该文件含密钥，已被 .gitignore 排除，不提交）。
#
#  课程要求（project_q1.md §2.1）：K_master 是 Alice 与 Bob 在通信之前
#  就已经共享的秘密，不能通过不安全的网络传输，因此用本文件"带外"配置。
#
#  ⚠ 安全提示
#    1. 本文件中的密钥只是**课程实验用测试值**，不是真实密钥管理方案；
#    2. 生产/真实场景应使用密钥管理系统或硬件安全模块；
#    3. 请保持本文件权限为 600，否则程序启动时会给出警告：
#           chmod 600 configs/keys.conf
#    4. 程序不会把密钥写进日志（只打印 16 位指纹）。
# ============================================================================

[identity]
# 通信双方的身份标识（协议握手时互相声明并验证）
alice_id = alice
bob_id   = bob

[keys]
# 长期认证密钥 K_master：16 字节 = 32 个十六进制字符
# 课程实验用测试值（Alice 与 Bob 必须完全一致）
master_key = 0f1e2d3c4b5a69788796a5b4c3d2e1f0
